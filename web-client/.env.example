# Build-time: where the browser should send API calls.
# Leave empty to use the same origin ("/api/v1/..."), which is what you want when a reverse proxy
# serves both the UI and the API, and what `npm run dev` / `npm run preview` do via the proxy below.
VITE_API_URL=

# Dev / preview only: where the Vite proxy forwards /api to (the Omu API).
OMU_API_PROXY=http://localhost:3000
